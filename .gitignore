# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Entornos y credenciales
.env
*.key

# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Temporales de Excel/Office
~$*
*.tmp
.Rproj.user

# R: sesion/historial pueden contener microdatos cargados en memoria
.RData
.Rhistory

# Datos fuente. A diferencia del repositorio de FACSECYD, que es publico, este
# repositorio es PRIVADO y guarda sus Excel de origen en data/ para que el
# equipo trabaje sobre el mismo material. Ver el README antes de cambiar esto:
# si el repositorio se hiciera publico, los Excel quedarian expuestos en todo
# el historial, no solo en el ultimo commit.
#
# Fuera de data/ ningun Excel entra, este donde este.
*.xlsx
*.xls
# Se habilitan uno por uno, a proposito: asi ningun archivo nuevo que aparezca
# en data/ se sube sin que alguien lo decida.
!data/data_docente.xlsx

# Tablas intermedias con datos personales (salida de los pasos de depuracion)
build/
